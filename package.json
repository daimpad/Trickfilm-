    "video": "node tools/noch-nicht.js 7 video",
    "studio": "remotion studio",
    "render": "remotion render",
    "galerie": "node tools/noch-nicht.js 7 galerie",
    "drehbuch": "node tools/noch-nicht.js 7 drehbuch"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.535",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
