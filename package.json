    "szene:kontaktbogen": "node tools/noch-nicht.js 2 szene:kontaktbogen",
    "szene:protokoll": "node tools/noch-nicht.js 2 szene:protokoll",
    "requisiten": "node tools/noch-nicht.js 2 requisiten",
    "figuren:vorlagen": "node tools/noch-nicht.js 3 figuren:vorlagen",
    "figuren:import": "node tools/noch-nicht.js 3 figuren:import",
    "sfx:cues": "node tools/noch-nicht.js 4 sfx:cues",
    "sfx:messen": "node tools/noch-nicht.js 4 sfx:messen",
    "sfx:normalisieren": "node tools/noch-nicht.js 4 sfx:normalisieren",
    "sfx:hoerprobe": "node tools/noch-nicht.js 4 sfx:hoerprobe",
