{
  "name": "trickfilm",
  "version": "0.1.0",
  "private": true,
  "description": "Werkstatt für KI-gestützte Trickfilme mit Vertonung und Geräuschen",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
