{
  "name": "trickfilm",
  "version": "0.1.0",
  "private": true,
  "description": "Werkstatt für KI-gestützte Trickfilme mit Vertonung und Geräuschen",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.js\" \"test/**/*.test.ts\"",
    "verboten": "tsx tools/pruefen-verboten.ts",
    "erzeugt:pruefen": "node tools/figuren-erzeugen.js --pruefen && node tools/import-teilesatz.js alle --pruefen && node tools/sfx-cues.js alle --pruefen && node lib/protokoll.js alle --pruefen && tsx tools/ton-pruefen.ts && node tools/remotion.js vorbereiten --pruefen && node tools/bausteine.js --pruefen",
    "pruefen": "npm run typecheck && npm run test && npm run verboten && npm run szene:bauen -- alle && npm run erzeugt:pruefen",
    "szene:neu": "tsx tools/neue-szene.ts",
    "szene:entfernen": "tsx tools/szene-entfernen.ts",
    "szene:bauen": "node lib/build.js",
    "szene:kontaktbogen": "node lib/kontaktbogen.js",
    "szene:vorschau": "node tools/szene-vorschau.js",
    "szene:protokoll": "node lib/protokoll.js",
    "editor": "node tools/posen-editor.js",
    "mimik": "node tools/mimik-editor.js",
    "teile": "node tools/teile-werkstatt.js",
    "requisiten": "node tools/requisiten-katalog.js",
    "bausteine": "node tools/bausteine.js",
    "figuren:erzeugen": "node tools/figuren-erzeugen.js",
    "figuren:testposen": "node tools/rig-testposen.js",
    "figuren:vorlagen": "node tools/figuren-erzeugen.js && node tools/vorlagen-bild.js",
    "figuren:import": "node tools/import-teilesatz.js",
    "sfx:cues": "node tools/sfx-cues.js",
    "sfx:messen": "node tools/sfx-normalisieren.js --messen",
    "sfx:normalisieren": "node tools/sfx-normalisieren.js",
    "sfx:hoerprobe": "node tools/sfx-hoerprobe.js",
    "sfx:kosten": "node tools/sfx-kosten.js",
    "sfx:ablegen": "node tools/sfx-ablegen.js",
    "stimme": "tsx tools/stimme.ts",
    "wortzeit": "tsx tools/wortzeit.ts",
    "untertitel": "tsx tools/untertitel.ts",
    "mischen": "tsx tools/mischen.ts",
    "video": "node tools/video.js",
    "studio": "node tools/remotion.js vorbereiten && remotion studio",
    "render": "node tools/remotion.js render",
    "remotion:paritaet": "node tools/remotion.js paritaet",
    "galerie": "tsx tools/galerie.ts",
    "drehbuch": "node tools/noch-nicht.js 7 drehbuch"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.535",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
