{
  "name": "trickfilm",
  "version": "0.1.0",
  "private": true,
  "description": "Werkstatt für KI-gestützte Trickfilme mit Vertonung und Geräuschen",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.js\" \"test/**/*.test.ts\"",
    "verboten": "tsx tools/pruefen-verboten.ts",
    "erzeugt:pruefen": "node tools/figuren-erzeugen.js --pruefen && node tools/import-teilesatz.js alle --pruefen && node lib/protokoll.js alle --pruefen",
    "pruefen": "npm run typecheck && npm run test && npm run verboten && npm run szene:bauen -- alle && npm run erzeugt:pruefen",
    "szene:neu": "tsx tools/neue-szene.ts",
    "szene:bauen": "node lib/build.js",
    "szene:kontaktbogen": "node lib/kontaktbogen.js",
    "szene:protokoll": "node lib/protokoll.js",
    "editor": "node tools/posen-editor.js",
    "teile": "node tools/teile-werkstatt.js",
    "requisiten": "node tools/requisiten-katalog.js",
    "figuren:erzeugen": "node tools/figuren-erzeugen.js",
    "figuren:testposen": "node tools/rig-testposen.js",
    "figuren:vorlagen": "node tools/figuren-erzeugen.js && node tools/vorlagen-bild.js",
    "figuren:import": "node tools/import-teilesatz.js",
    "sfx:cues": "node tools/noch-nicht.js 4 sfx:cues",
    "sfx:messen": "node tools/noch-nicht.js 4 sfx:messen",
    "sfx:normalisieren": "node tools/noch-nicht.js 4 sfx:normalisieren",
    "sfx:hoerprobe": "node tools/noch-nicht.js 4 sfx:hoerprobe",
    "stimme": "node tools/noch-nicht.js 6 stimme",
    "wortzeit": "node tools/noch-nicht.js 6 wortzeit",
    "untertitel": "node tools/noch-nicht.js 6 untertitel",
    "mischen": "node tools/noch-nicht.js 6 mischen",
    "video": "node tools/noch-nicht.js 7 video",
    "studio": "remotion studio",
    "render": "remotion render",
    "galerie": "node tools/noch-nicht.js 7 galerie",
    "drehbuch": "node tools/noch-nicht.js 7 drehbuch"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.535",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
